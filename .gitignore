# Lo compilado y lo generado no entra. Los subarboles que venian de un
# repositorio traen ademas su propio .gitignore, que sigue mandando dentro
# de su directorio.

# --- objetos y binarios ---------------------------------------------------
*.o
*.a
*.so
*.exe
*.dll
*.ppu
*.tpu
obj/
bin/
build/

# --- lo que producen los motores ------------------------------------------
*.out
*.pre
*.aux
*.log
*.dvi
*.toc
*.eps
*.pdf
*.ps

# --- samples -------------------------------------------------------------
# Por decision del proyecto: las muestras NO se versionan.
samples/

# --- lo del banco ---------------------------------------------------------
rt.*/

# binarios sin extension que los Makefile dejan en su sitio
engines/fug/fug
engines/fug/gtk_fmg
engines/fug/tests/gui/work/

# --- literatura y binarios precompilados ----------------------------------
# Los articulos tienen copyright y NO van a un repositorio que puede ser
# publico: viven en ~/Dropbox/SRC/literatura/ y se catalogan en
# docs/LITERATURA.md. Los motores compilados no tienen sentido en un repo.
literature/
engines/*/literature/
engine/*.exe
gui/*/engine/

# los binarios de los GUI: se construyen, no se guardan
gui/drtran/drtran_gui
gui/fue/gtk_fue
gui/fug/gtk_fug
gui/drtran/tests/work/

# BINARIOS: no van al repositorio. Ya paso una vez con gui/drtran/mtram.
gui/fug/gtk_fmg
gui/atsw/atsw_gui

# LOS DIRECTORIOS DE TRABAJO DE LAS PRUEBAS. Habia 94 + 8 ficheros RASTREADOS
# en dos carpetas que el propio banco empieza borrando con "rm -rf $WORK": no
# podian ser fixtures --la primera corrida los destruye-- y ensuciaban cada
# commit con la salida de la ultima ejecucion.
#
# OJO: los work/ de engines/drvarma/cases NO son esto. Ahi viven los .inp,
# .pre y .out de los modelos del analista, que son el trabajo, no la salida de
# un banco. Esos se quedan.
engines/fug/tests/work/
engines/fug/tests/gui/work/

# el binario de la madre
gui/atsw/atsw_gui
capturas/
gui/atsw/test_gui_atsw
gui/atsw/atsw_hijo_falso
gui/atsw/tests/work/
