#!/bin/sh
# A stand-in for the engine, so that the tests do not depend on fue being
# installed: it answers with the exit status the first argument asks for and
# writes the kind of message the real one writes.
case "$1" in
  ok)
      echo "FUE: banner"
      echo "Created ok.pdf"
      exit 0 ;;
  bad)
      echo "Error in the input file bad.inp, line 2: the file ends too soon" >&2
      echo "FUE: banner"
      exit 2 ;;
  nofile)
      echo "Error opening input file: nofile.inp" >&2
      exit 1 ;;
  noest)
      echo "FUE: banner"
      echo "Warning: the model could not be estimated" >&2
      exit 3 ;;
  latin1)
      # UN MOTOR NO PROMETE UTF-8. Escribe lo que le llega: un nombre de
      # serie con los bytes con que estaba escrito, la salida de pdflatex o
      # la de gnuplot. Ese byte acaba en el mensaje y el mensaje en una
      # etiqueta de GTK.
      printf 'Error en la serie Espa\361a: no cuadra\n' >&2
      exit 2 ;;
  crash)
      kill -SEGV $$ ;;
  argv)
      # how many arguments arrived, and what the first one was
      printf '%d\n%s\n' "$#" "$1$2" ;;
  iter)
      # what the optimizer writes: the iteration and the objective, all in
      # one line and with no newline between them
      echo "FUE: banner"
      k=0
      while [ $k -le 12 ]; do
          printf '%4d F: %0.10f' "$k" "0.9$k"
          k=$((k + 1))
      done
      printf '\n'
      exit 0 ;;
esac
exit 1
